generator client {
  provider     = "prisma-client"
  output       = "../generated"
  moduleFormat = "esm"
  runtime      = "cloudflare"
}

// Cloudflare's wasm-edge query engine (above) only runs inside workerd —
// local Bun scripts (e.g. seed.ts) need this Node/Bun-targeted client
// instead.
generator clientNode {
  provider     = "prisma-client"
  output       = "../generated-node"
  moduleFormat = "esm"
  runtime      = "bun"
}

datasource db {
  provider = "postgresql"
}
